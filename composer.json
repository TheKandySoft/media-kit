{
    "name": "kandysoft/media-kit",
    "description": "Storage-agnostic media library for Laravel: uploads, per-locale captions and on-demand image variants on top of the framework's filesystem disks.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "media", "images", "uploads", "filesystem"],
    "homepage": "https://github.com/TheKandySoft/media-kit",
    "support": {
        "issues": "https://github.com/TheKandySoft/media-kit/issues",
        "source": "https://github.com/TheKandySoft/media-kit"
    },
    "require": {
        "php": "^8.3",
        "intervention/image": "^3.11",
        "laravel/framework": "^12.0|^13.0"
    },
    "suggest": {
        "ext-sodium": "Needed only to encrypt files at rest (media-kit.encryption)."
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "KandySoft\\MediaKit\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KandySoft\\MediaKit\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KandySoft\\MediaKit\\Providers\\MediaKitServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
